/*
  BasicMovement — базовые движения UniBase.

  Робот проезжает квадрат со стороной 300 мм:
  четыре прямых участка и четыре поворота на 90 градусов.

  Все команды блокирующие: каждая следующая начинается
  только после завершения предыдущей.
*/

#include <UNI.h>

UniBase robot("UNI");

void setup() {
  robot.begin(); // можно не вызывать: первая команда сделает это сама

  for (int i = 0; i < 4; i++) {
    robot.moveDist(50, 300); // вперед 300 мм на мощности 50
    robot.rotate(50, 90);    // поворот направо на 90 градусов
  }

  // Дополнительно: движение назад и по времени
  robot.moveDist(-50, 200);  // назад 200 мм
  robot.moveTime(40, 1000);  // вперед 1 секунду
  robot.moveTime(-40, 1000); // назад 1 секунду
}

void loop() {
}
