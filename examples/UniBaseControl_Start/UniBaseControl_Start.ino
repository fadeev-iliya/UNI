/*
  UniBaseControl_Start — управление платформой с Arduino Nano по UART.

  Эта прошивка загружается в ESP32 платформы UNI и превращает ее
  в исполнителя команд: внешняя плата (Arduino Nano с библиотекой
  UniBaseControl) отправляет команды движения по UART, а платформа
  их выполняет и отвечает данными одометрии.

  Подключение: UART2 платформы (RX 16, TX 17, 38400 бод)
  к TX/RX платы Nano.
*/

#include <UNI.h>

UniBase robot;

void setup() {
  robot.begin("UNI");
  robot.UniBaseControl(); // включаем прослушивание команд
}

void loop() {
  // Прием команд, движение и экран работают на втором ядре.
  // loop() свободен - сюда можно добавить свою логику.
}
