/*
  Tuning — настройка точности и характера движения под свою платформу.

  Все параметры регуляторов собраны в структуре TuningConfig:

    minPower       — минимальная мощность страгивания моторов
    pGain/iGain/dGain — ПИД прямолинейного движения
    rotateTolDeg   — допуск завершения поворота (град)
    rotateAccel    — замедление профиля поворота (тики/с^2)
    rotateMinSpeed — минимальная скорость подхода к углу
    moveTolMM      — допуск завершения движения (мм)
    moveAccel      — замедление профиля движения (тики/с^2)
    moveMinSpeed   — минимальная скорость подхода к цели

  Геометрия робота задается в UniConfig (диаметр колес, колея,
  тики на оборот) и передается в конструктор.

  Подсказки:
  - робот перелетает точку на высокой мощности -> уменьшите moveAccel;
  - конец движения кажется вялым -> увеличьте moveAccel;
  - нужен более точный угол -> уменьшите rotateTolDeg;
  - физический угол не совпадает с одометрией -> калибруйте
    trackLengthMM в UniConfig, а не ПИД.
*/

#include <UNI.h>

// Геометрию платформы можно переопределить через UniConfig
UniConfig cfg;          // значения по умолчанию...
// cfg.trackLengthMM = 106.0f;   // ...при необходимости меняются до создания робота

UniBase robot("UNI", cfg);

void setup() {
  robot.begin();

  // Берем текущие настройки, меняем нужное и применяем
  TuningConfig tuning = robot.getTuning();
  tuning.rotateTolDeg = 0.5f;   // точнее повороты
  tuning.moveAccel    = 1500.0f; // мягче торможение на прямой
  robot.setTuning(tuning);

  // Тестовый заезд с новыми настройками
  robot.moveDist(70, 500);
  robot.rotate(70, 180);
  robot.moveDist(70, 500);
  robot.rotate(70, 180);

  // По одометрии видно качество возврата в исходную точку
  robot.displayPrint("X err", robot.getAbsX());
}

void loop() {
}
